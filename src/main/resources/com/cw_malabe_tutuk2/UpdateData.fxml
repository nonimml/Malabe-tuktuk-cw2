<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>

<GridPane alignment="CENTER" hgap="10" prefHeight="625" prefWidth="1150" vgap="15" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cw_malabe_tutuk2.UpdateInventoryController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <Label text="Part Code:" GridPane.columnIndex="1" />
    <TextField fx:id="codeField" promptText="e.g:P100" GridPane.columnIndex="2" />


    <Label text="Category:" GridPane.columnIndex="1" GridPane.rowIndex="1" />
    <TextField fx:id="type" promptText="e.g.Brakes" GridPane.columnIndex="2" GridPane.rowIndex="1" />

    <Label text="Brand: " GridPane.columnIndex="1" GridPane.rowIndex="2" />
    <TextField fx:id="brand" promptText="e.g., Bajaj" GridPane.columnIndex="2" GridPane.rowIndex="2" />

    <Label text="Part Name:" GridPane.columnIndex="1" GridPane.rowIndex="3" />
    <TextField fx:id="name" promptText="e.g., Brake Cable" GridPane.columnIndex="2" GridPane.rowIndex="3" />


    <Label text="Price (Rs.):" GridPane.columnIndex="1" GridPane.rowIndex="4" />
    <TextField fx:id="price" promptText="0.00" GridPane.columnIndex="2" GridPane.rowIndex="4" />


    <Label text="Quantity: " GridPane.columnIndex="1" GridPane.rowIndex="5" />
    <TextField fx:id="stock" promptText="0" GridPane.columnIndex="2" GridPane.rowIndex="5" />

    <Label text="Date: " GridPane.columnIndex="1" GridPane.rowIndex="6" />
    <TextField fx:id="date" promptText="Format : DD/MM/YYYY" GridPane.columnIndex="2" GridPane.rowIndex="6" />

    <Label text="image Path: " GridPane.columnIndex="1" GridPane.rowIndex="7" />
    <TextField fx:id="imagePath" promptText="e.g: image.jpg" GridPane.columnIndex="2" GridPane.rowIndex="7" />

    <Label text="Low-Stock Threshold: " GridPane.columnIndex="1" GridPane.rowIndex="8" />
    <TextField fx:id="lowStock" promptText="Stock threshold" GridPane.columnIndex="2" GridPane.rowIndex="8" />

    <HBox alignment="CENTER_RIGHT" spacing="10" GridPane.columnIndex="2" GridPane.rowIndex="9">
        <Button onAction="#insert" text="Save" />
        <Button onAction="#Cancel" text="Cancel" />
    </HBox>

    <columnConstraints>
        <ColumnConstraints />
        <ColumnConstraints />
        <ColumnConstraints />
    </columnConstraints>
    <rowConstraints>
        <RowConstraints />
        <RowConstraints />
        <RowConstraints />
        <RowConstraints />
        <RowConstraints />
        <RowConstraints />
        <RowConstraints />
        <RowConstraints />
        <RowConstraints />
        <RowConstraints />
    </rowConstraints>
</GridPane>
