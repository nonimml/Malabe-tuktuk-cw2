<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="625" prefWidth="1150" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cw_malabe_tutuk2.Controller">
    <top>
        <HBox alignment="CENTER" prefHeight="46.0" prefWidth="1150.0" BorderPane.alignment="CENTER">
            <children>
                <Label alignment="CENTER" contentDisplay="CENTER" text="Malabe Tuk-Tuk And Three-Wheeler Spares Depot">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
            </children>
        </HBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.72">
            <items>
                <VBox spacing="10" style="-fx-padding: 10;">
                    <Label text="Inventory Management">
                        <font>
                            <Font name="System Bold" size="12.0" />
                        </font></Label>

                    <HBox alignment="CENTER_LEFT" spacing="5">
                        <ComboBox fx:id="categoryFilter" />
                        <TextField fx:id="minPriceInput" prefWidth="80.0" promptText="Min Price" />
                        <TextField fx:id="maxPriceInput" prefWidth="80.0" promptText="Max Price" />
                        <Button onAction="#FilterInventory" text="Apply Filter" />
                        <Button onAction="#ResetFilters" text="Reset Filters" />
                    </HBox>

                    <TableView fx:id="inventoryTable" VBox.vgrow="ALWAYS">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>

                        <columns>
                            <TableColumn fx:id="Code" text="Part Code" />
                            <TableColumn fx:id="Name" text="Name" />
                            <TableColumn fx:id="Brand" text="Brand" />
                            <TableColumn fx:id="Type" text="Category" />
                            <TableColumn fx:id="Date" text="Date" />
                            <TableColumn fx:id="Price" text="Price" />
                            <TableColumn fx:id="Quantity" text="Quantity" />
                            <TableColumn fx:id="Image" text="Image" />
                            <TableColumn fx:id="addToCart" text="Add To Cart" />
                        </columns>
                    </TableView>
                    <HBox spacing="20">
                        <Label fx:id="totalCountLabel" text="Total Parts: 0" />
                        <Label fx:id="totalValueLabel" text="Total Inventory Value: Rs. 0.00" />
                    </HBox>

                    <HBox spacing="10">
                        <Button fx:id="addBtn" onAction="#AddProduct" text="Add Part" />
                        <Button fx:id="updateBtn" onAction="#UpdateProduct" text="Update Part" />
                        <Button onAction="#DeletePart" text="Delete Part" />
                    </HBox>
                </VBox>

                <VBox spacing="10" style="-fx-padding: 10;">
                    <Label style="-fx-font-weight: bold;" text="Point of Sale (POS)" />
                    <TableView fx:id="posTable" prefHeight="290.0" prefWidth="267.0">
                        <columns>
                            <TableColumn fx:id="partCode" prefWidth="75.0" text="Part Code" />
                            <TableColumn fx:id="partName" prefWidth="75.0" text="Part Name" />
                            <TableColumn fx:id="unitPrice" prefWidth="75.0" text="Unit Price" />
                            <TableColumn fx:id="partQuantity" prefWidth="75.0" text="Quantity" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                    <VBox spacing="5" style="-fx-padding: 5; -fx-border-color: #cccccc; -fx-border-width: 1;">
                        <Label fx:id="subtotalLabel" text="Subtotal: " />
                        <Label fx:id="bulkDiscountLabel" text="Bulk Discount: " />
                        <Label fx:id="synergyDiscountLabel" text="Synergy Discount: " />
                        <Label fx:id="netTotalLabel" style="-fx-font-weight: bold;" text="Net Total: " />
                        <Separator />
                        <HBox alignment="CENTER_LEFT" fillHeight="false" prefHeight="100.0" prefWidth="200.0" spacing="120.0">
                            <children>

                                <Button alignment="CENTER" contentDisplay="CENTER" onAction="#checkOut" text="Process Checkout" />
                                <Button fx:id="clearTable" alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#checkOut" prefHeight="25.0" prefWidth="75.0" text="Clear" textAlignment="CENTER" />
                            </children>
                        </HBox>
                    </VBox>
                </VBox>
            </items>
            <cursor>
                <Cursor fx:constant="DEFAULT" />
            </cursor>
        </SplitPane>
    </center>

    <bottom>
        <VBox spacing="10" style="-fx-padding: 10; -fx-border-color: #cccccc; -fx-border-width: 1 0 0 0;">

            <VBox spacing="5">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label style="-fx-font-weight: bold;" text="Low-Stock Warnings" />
                    <Label fx:id="lowStockWarning" text="Alert Threshold:" />
                </HBox>
                <ListView fx:id="lowStockWarningArea" prefHeight="80.0" prefWidth="1180.0" />
            </VBox>

            <Separator />

            <VBox spacing="5">
                <Label style="-fx-font-weight: bold;" text="Dealer Selection" />
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Button onAction="#openDealerWindow" text="Randomize 4 Dealers" />
                </HBox>
            </VBox>
        </VBox>
    </bottom>
</BorderPane>
