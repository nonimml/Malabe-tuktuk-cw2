<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600" prefWidth="1000" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cw_malabe_tutuk.DealerViewController">
    <children>
        <TableView fx:id="DealerTable" layoutX="184.0" layoutY="130.0" prefHeight="310.0" prefWidth="635.0">
            <columns>
                <TableColumn fx:id="dealerId" prefWidth="75.0" text="Dealer Id" />
                <TableColumn fx:id="dealerName" prefWidth="75.0" text="Dealer Name" />
                <TableColumn fx:id="dealerContact" prefWidth="75.0" text="Contact" />
                <TableColumn fx:id="dealerLocation" prefWidth="75.0" text="Location" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
        <Label alignment="CENTER" contentDisplay="CENTER" layoutX="374.0" layoutY="41.0" prefHeight="53.0" prefWidth="254.0" text="Random Dealers Deatails">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <HBox alignment="CENTER" layoutX="772.0" layoutY="517.0" prefHeight="69.0" prefWidth="214.0">
            <children>
                <Button alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#ViewRandomDealers" prefHeight="33.0" prefWidth="84.0" text="Refresh" />
            </children>
        </HBox>
    </children>
</AnchorPane>
